PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
CHAT_ROOM_ID=private-room

# Development option: set one long shared passphrase.
# The browser does not send this passphrase to the backend; it sends a derived access proof.
CHAT_PASSWORD=change-this-to-a-long-random-passphrase

# Production option: prefer CHAT_ACCESS_PROOF_HASH instead of CHAT_PASSWORD.
# Generate it with:
# npm run make-secret -- "your long shared passphrase" private-room
# CHAT_ACCESS_PROOF_HASH=scrypt$32768$8$1$...

# Use at least 32 random characters. Generate with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
CHAT_TOKEN_SECRET=replace-with-at-least-32-random-characters

TOKEN_TTL_MINUTES=20
MESSAGE_MAX_LENGTH=1200
ENCRYPTED_MESSAGE_MAX_LENGTH=6000
REQUIRE_HTTPS=true

